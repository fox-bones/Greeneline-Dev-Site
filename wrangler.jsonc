{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cayce-greene",
  "main": "./server/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Static files are served straight from Cloudflare's edge. Only /api/* wakes the Worker.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare creates the DNS records and certificates for these on deploy.
  "routes": [
    { "pattern": "greenelinedev.com", "custom_domain": true },
    { "pattern": "www.greenelinedev.com", "custom_domain": true }
  ],
  // The site lives on its own domain, so the extra Cloudflare addresses stay off.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
